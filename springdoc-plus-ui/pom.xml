<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.weimin96</groupId>
    <artifactId>springdoc-plus</artifactId>
    <version>0.1.4</version>
  </parent>

  <artifactId>springdoc-plus-ui</artifactId>
  <name>springdoc-plus-ui</name>
  <packaging>jar</packaging>

  <properties>
    <frontend.workingDirectory>${project.basedir}/../springdoc-plus-web</frontend.workingDirectory>
    <frontend.outputDirectory>${project.build.outputDirectory}/META-INF/resources/springdoc-plus-ui</frontend.outputDirectory>
    <skipFrontendBuild>false</skipFrontendBuild>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>build-web-ui</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipFrontendBuild}</skip>
              <workingDirectory>${frontend.workingDirectory}</workingDirectory>
              <executable>pnpm</executable>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <filesets>
            <fileset>
              <directory>${frontend.outputDirectory}</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-built-ui</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${frontend.outputDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${frontend.workingDirectory}/dist</directory>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/main/resources</directory>
                  <excludes>
                    <exclude>META-INF/resources/springdoc-plus-ui/**</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
