{
  "name": "springdoc-plus-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"*.{ts,json}\"",
    "copy": "npm run copy:clean && npm run copy:files",
    "copy:clean": "node -e \"const fs=require('fs');const p='../springdoc-plus-ui/src/main/resources/META-INF/resources/springdoc-plus-ui';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true});console.log('Deleted:',p)}\"",
    "copy:files": "node -e \"const fs=require('fs');const src='./dist';const dest='../springdoc-plus-ui/src/main/resources/META-INF/resources/springdoc-plus-ui';function copyDir(s,d){if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>{const sp=require('path').join(s,f),dp=require('path').join(d,f);fs.statSync(sp).isDirectory()?copyDir(sp,dp):fs.copyFileSync(sp,dp)})};copyDir(src,dest);console.log('Copied to:',dest)\"",
    "deploy": "npm run build && npm run copy"
  },
  "dependencies": {
    "docxtemplater": "^3.68.3",
    "file-saver": "^2.0.5",
    "pizzip": "^3.2.0",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.3.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.9.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.5"
  }
}
